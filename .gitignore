# ==========================================
# LARGE GENERATED EXPERIMENT ARTIFACTS
# ==========================================

# Cached training/validation arrays and scalers
/artifacts/**/cache/

# Generated NumPy arrays and serialized objects
# inside the artifacts directory
/artifacts/**/*.npy
/artifacts/**/*.npz
/artifacts/**/*.pkl
/artifacts/**/*.pickle
/artifacts/**/*.joblib

# ==========================================
# MODEL CHECKPOINTS
# ==========================================

# Ignore all generated training checkpoints
# across experiments
/experiments/**/checkpoints/*
!/experiments/proposed_no_quantum/horizon_15/run_[1-5]/checkpoints/best_checkpoint.pt

# ==========================================
# LARGE EVALUATION PREDICTION FILES
# ==========================================

# Compressed prediction arrays
/evaluation/**/*.npy
/evaluation/**/*.npz
/evaluation/**/predictions.csv
!/evaluation/proposed_no_quantum/horizon_15/run_[1-5]/results/predictions.csv

# Full per-sample prediction CSVs
/evaluation/**/baseline_predictions.csv
/evaluation/**/classical_predictions.csv
/evaluation/**/quantum_predictions.csv

# ==========================================
# KAGGLE TEMPORARY OUTPUTS
# ==========================================

/kaggle/working/
/outputs/
/tensorboard/

